{
  "name": "youtube-yoda",
  "version": "1.0.0",
  "description": "Complete YouTube Channel Automation & Growth Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t youtube-yoda .",
    "docker:run": "docker run -p 3000:3000 youtube-yoda",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "ts-node src/database/seed.ts"
  },
  "keywords": [
    "youtube",
    "automation",
    "api",
    "growth",
    "analytics",
    "content-creation"
  ],
  "author": "Your Name",
  "license": "MIT",
