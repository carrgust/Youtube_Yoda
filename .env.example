# Environment Configuration for YouTube Yoda

# Node Environment
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/youtube_yoda
REDIS_URL=redis://localhost:6379
MONGODB_URL=mongodb://localhost:27017/youtube_yoda_logs

# YouTube API Configuration
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback
YOUTUBE_API_KEY=your_api_key_here

# OpenAI Configuration (for AI features)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORGANIZATION=your_org_id_here

# Google Cloud Configuration (for additional services)
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_CLOUD_KEYFILE=path/to/keyfile.json
GOOGLE_CLOUD_STORAGE_BUCKET=youtube-yoda-media

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
SESSION_SECRET=your_session_secret_here
BCRYPT_ROUNDS=10

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=134217728
UPLOAD_DIRECTORY=./uploads

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Monitoring (optional)
SENTRY_DSN=your_sentry_dsn_here
PROMETHEUS_PORT=9090

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_ANALYTICS=true
ENABLE_WEBHOOKS=true
ENABLE_SCHEDULED_UPLOADS=true

# External Services (optional)
TUBEBUDDY_API_KEY=your_tubebuddy_key
VIDIQ_API_KEY=your_vidiq_key
STRIPE_API_KEY=your_stripe_key_for_payments
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Cache Configuration
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE_MB=1000

# Worker Configuration
WORKER_CONCURRENCY=5
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY_MS=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3001

# API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs